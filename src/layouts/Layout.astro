---
const { title = 'MASSERIES ORIENTALES', description = 'Noticias y resúmenes de series orientales.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Masseries Orientales, inicio">M<span>O</span></a>
      <nav aria-label="Navegación principal">
        <a class:list-active={currentPath === '/'} href="/">Home</a>
        <a class:list-active={currentPath.startsWith('/galeria')} href="/galeria">Galería</a>
      </nav>
      <a class="header-link" href="#suscribete">Recibe el resumen <span aria-hidden="true">↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="brand" href="/">M<span>O</span></a>
      <p>Historias para mirar más allá de la pantalla.</p>
      <span class="footer-note">© 2024 / Hecho con curiosidad</span>
    </footer>
  </body>
</html>

<style is:global>
  :root { --ink: #20211f; --paper: #f6f1e9; --coral: #e9654b; --sun: #f3c969; --muted: #716e67; --line: #d9d1c5; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'Manrope', sans-serif; }
  a { color: inherit; text-decoration: none; }
  .site-header { max-width: 1320px; margin: auto; padding: 28px 5vw 22px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); }
  .brand { font-size: 22px; font-weight: 800; letter-spacing: -.08em; line-height: 1; }
  .brand span { color: var(--coral); }
  nav { display: flex; gap: 32px; font-size: 13px; font-weight: 700; }
  nav a { padding: 9px 0; color: var(--muted); }
  nav a:hover, nav a.list-active { color: var(--ink); border-bottom: 2px solid var(--coral); }
  .header-link { justify-self: end; font: 500 10px 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .header-link span { color: var(--coral); font-size: 16px; margin-left: 6px; }
  .site-footer { max-width: 1320px; margin: 80px auto 0; padding: 24px 5vw 32px; display: flex; gap: 28px; align-items: center; border-top: 1px solid var(--line); font-size: 12px; }
  .site-footer p { margin: 0; color: var(--muted); }
  .footer-note { margin-left: auto; color: var(--muted); font: 10px 'DM Mono', monospace; text-transform: uppercase; }
  @media (max-width: 640px) { .site-header { grid-template-columns: 1fr auto; gap: 20px; padding-top: 22px; } .site-header nav { order: 3; grid-column: 1 / -1; justify-content: center; gap: 28px; } .header-link { font-size: 9px; } .site-footer { flex-wrap: wrap; gap: 14px; } .footer-note { width: 100%; margin-left: 0; } }
</style>