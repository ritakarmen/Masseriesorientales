---
import Layout from '../layouts/Layout.astro';
import { stories } from '../data/series.js';

const [featured, ...secondaryStories] = stories;
---
<Layout title="Masseries Orientales | Noticias y resúmenes" description="Noticias, resúmenes y recomendaciones de series coreanas, japonesas y chinas.">
  <section class="intro-shell">
    <div class="intro-copy">
      <p class="eyebrow">MASSERIES ORIENTALES <span>·</span> CINE Y SERIES</p>
      <h1>Historias de<br /><em>otro mundo.</em></h1>
      <p class="intro-text">Resúmenes, recomendaciones y detalles para encontrar tu próxima historia favorita de Asia oriental.</p>
      <a class="text-link" href="#ultimas">Encuentra tu próxima serie <span aria-hidden="true">↓</span></a>
    </div>
    <aside class="intro-note" aria-label="Sobre la selección">
      <span class="note-index">01 — 04</span>
      <div class="orbit-mark" aria-hidden="true"><span></span></div>
      <p>Del romance coreano al misterio japonés. Historias elegidas para quedarse un rato más.</p>
      <span class="note-caption">UNA GUÍA PARA MIRAR MEJOR</span>
    </aside>
  </section>

  <section class="featured-story" id="destacada" data-story-category={featured.category}>
    <a class="featured-image" href="#ultimas" aria-label={`Explorar historias como ${featured.title}`}>
      <img src={featured.image} alt={`Escenario de ${featured.title}`} loading="eager" />
      <span class="image-label">EN PORTADA <span aria-hidden="true">↗</span></span>
    </a>
    <article class="featured-copy">
      <div class="story-meta"><span>{featured.category}</span><span>{featured.date}</span></div>
      <p class="featured-kicker">EL RESUMEN DESTACADO</p>
      <h2>{featured.title}</h2>
      <p class="featured-excerpt">{featured.excerpt}</p>
      <a class="featured-link" href="#ultimas">Descubrir más historias <span aria-hidden="true">↗</span></a>
    </article>
  </section>

  <section class="latest-section" id="ultimas">
    <div class="section-heading">
      <div><p class="eyebrow">ELIGE POR DÓNDE EMPEZAR</p><h2>Historias para ver</h2></div>
      <span class="story-count" aria-live="polite">04 HISTORIAS</span>
    </div>
    <div class="filter-row" role="group" aria-label="Filtrar historias por categoría">
      <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">Todo</button>
      <button class="filter-button" type="button" data-filter="K-DRAMA" aria-pressed="false">Corea</button>
      <button class="filter-button" type="button" data-filter="J-DRAMA" aria-pressed="false">Japón</button>
      <button class="filter-button" type="button" data-filter="C-DRAMA" aria-pressed="false">China</button>
      <button class="filter-button" type="button" data-filter="LISTAS" aria-pressed="false">Listas</button>
    </div>
    <div class="story-grid">
      {secondaryStories.map((story) => (
        <article class="story-card" data-story-category={story.category}>
          <a class="story-image" href="/galeria" aria-label={`Ver galería: ${story.title}`}><img src={story.image} alt={`Escenario de ${story.title}`} loading="lazy" /><span aria-hidden="true">↗</span></a>
          <div class="story-card-body">
            <div class="story-meta"><span>{story.category}</span><span>{story.date}</span></div>
            <h3>{story.title}</h3>
            <p>{story.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="empty-state" hidden>No hay historias en esta categoría todavía.</p>
  </section>

  <section class="gallery-cta" id="suscribete">
    <div><p class="eyebrow">UN POCO MÁS ALLÁ DEL GUIÓN</p><h2>Entra en el mundo<br /><em>de cada historia.</em></h2></div>
    <a href="/galeria" class="gallery-link">Explorar la galería <span aria-hidden="true">↗</span></a>
  </section>
</Layout>

<style>
  .intro-shell, .featured-story, .latest-section, .gallery-cta { max-width: 1240px; margin-inline: auto; padding-inline: 5vw; }
  .intro-shell { min-height: 400px; padding-top: 72px; padding-bottom: 58px; display: grid; grid-template-columns: 1fr 230px; gap: 80px; align-items: center; }
  .eyebrow, .story-meta, .note-index, .note-caption, .story-count { font: 500 10px 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { color: var(--coral); margin: 0 0 22px; }.eyebrow span { color: var(--ink); margin: 0 5px; }
  h1, h2, h3, p { margin-top: 0; }.intro-copy h1 { margin: 0; font-size: clamp(58px, 8vw, 100px); line-height: .88; letter-spacing: -.075em; font-weight: 800; }.intro-copy h1 em, .gallery-cta h2 em { color: var(--coral); font-family: 'Playfair Display', serif; font-weight: 700; letter-spacing: -.04em; }
  .intro-text { max-width: 390px; margin: 25px 0 23px; color: var(--muted); font-size: 14px; line-height: 1.7; }.text-link { display: inline-block; font-size: 12px; font-weight: 800; border-bottom: 1px solid var(--ink); padding-bottom: 8px; }.text-link span { margin-left: 18px; color: var(--coral); }
  .intro-note { min-height: 240px; padding: 18px 0 0 22px; border-left: 1px solid var(--line); display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; }.note-index, .note-caption { color: var(--muted); font-size: 9px; }.intro-note p { max-width: 190px; margin: 0; font-size: 12px; line-height: 1.65; color: var(--muted); }.orbit-mark { width: 68px; height: 68px; border: 1px solid var(--line); border-radius: 50%; display: grid; place-items: center; position: relative; }.orbit-mark::before { content: ''; width: 42px; height: 42px; border: 1px solid var(--coral); border-radius: 50%; }.orbit-mark span { position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--sun); top: 5px; right: 7px; }
  .featured-story { display: grid; grid-template-columns: 1.4fr 1fr; min-height: 400px; }.featured-image { min-height: 400px; position: relative; overflow: hidden; background: var(--ink); }.featured-image img, .story-image img { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(.8); transition: transform .45s ease, filter .3s ease; }.featured-image:hover img, .story-image:hover img { transform: scale(1.035); filter: saturate(1); }.image-label { position: absolute; top: 18px; left: 18px; padding: 10px 12px; background: var(--sun); font: 500 9px 'DM Mono', monospace; letter-spacing: .08em; }.image-label span { margin-left: 18px; font-size: 13px; }.featured-copy { min-height: 400px; padding: 36px 38px; background: var(--coral); display: flex; flex-direction: column; align-items: flex-start; }.story-meta { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 9px; }.featured-copy .story-meta { color: var(--ink); }.featured-kicker { margin: 58px 0 12px; font: 500 9px 'DM Mono', monospace; letter-spacing: .08em; }.featured-copy h2 { max-width: 460px; margin: 0 0 14px; font-size: clamp(30px, 3.5vw, 48px); line-height: .99; letter-spacing: -.06em; }.featured-excerpt { max-width: 370px; margin: 0 0 22px; font-size: 12px; line-height: 1.65; }.featured-link { margin-top: auto; padding-bottom: 7px; border-bottom: 1px solid var(--ink); font-size: 11px; font-weight: 800; }.featured-link span { margin-left: 20px; }
  .latest-section { padding-top: 92px; }.section-heading { display: flex; justify-content: space-between; align-items: end; border-bottom: 1px solid var(--ink); padding-bottom: 15px; }.section-heading .eyebrow { margin-bottom: 12px; }.section-heading h2 { margin: 0; font-size: 32px; letter-spacing: -.06em; }.story-count { padding-bottom: 4px; color: var(--muted); }.filter-row { display: flex; flex-wrap: wrap; gap: 7px; padding: 18px 0 8px; }.filter-button { border: 1px solid var(--line); background: transparent; color: var(--muted); padding: 9px 14px; font: 500 10px 'DM Mono', monospace; text-transform: uppercase; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }.filter-button:hover, .filter-button.is-active { color: var(--paper); background: var(--ink); border-color: var(--ink); }.filter-button:focus-visible, a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
  .story-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 22px; padding-top: 17px; }.story-card { min-width: 0; }.story-image { display: block; position: relative; aspect-ratio: 1.35; overflow: hidden; background: var(--line); }.story-image > span { position: absolute; right: 12px; bottom: 12px; width: 34px; height: 34px; display: grid; place-items: center; background: var(--sun); font-size: 16px; }.story-card-body { padding-top: 15px; }.story-card h3 { margin: 12px 0 9px; font-size: 20px; line-height: 1.08; letter-spacing: -.045em; }.story-card p { max-width: 330px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }.empty-state { padding: 36px 0; color: var(--muted); font-size: 13px; }.gallery-cta { margin-top: 100px; padding-top: 40px; padding-bottom: 42px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); display: flex; justify-content: space-between; align-items: end; gap: 30px; }.gallery-cta .eyebrow { margin-bottom: 17px; }.gallery-cta h2 { margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: .97; letter-spacing: -.06em; }.gallery-link { padding: 13px 0; border-bottom: 1px solid var(--ink); font-size: 12px; font-weight: 800; white-space: nowrap; }.gallery-link span { margin-left: 28px; color: var(--coral); }
  @media (max-width: 760px) { .intro-shell { min-height: auto; padding-top: 58px; grid-template-columns: 1fr; gap: 36px; }.intro-note { min-height: 175px; }.featured-story { grid-template-columns: 1fr; }.featured-image { min-height: 300px; }.featured-copy { min-height: 330px; padding: 30px; }.featured-kicker { margin-top: 42px; }.story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 14px; }.gallery-cta { margin-top: 75px; } }
  @media (max-width: 480px) { .intro-copy h1 { font-size: 58px; }.section-heading h2 { font-size: 27px; }.story-grid { grid-template-columns: 1fr; }.story-image { aspect-ratio: 1.5; }.gallery-cta { align-items: flex-start; flex-direction: column; }.gallery-link { margin-top: 8px; } }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const storyItems = document.querySelectorAll<HTMLElement>('[data-story-category]');
  const storyCount = document.querySelector('.story-count');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      storyItems.forEach((item) => {
        const isVisible = filter === 'all' || item.dataset.storyCategory === filter;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (storyCount) storyCount.textContent = `${String(visibleCount).padStart(2, '0')} HISTORIAS`;
      if (emptyState) emptyState.hidden = visibleCount > 0;
    });
  });
</script>