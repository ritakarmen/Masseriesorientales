---
import Layout from '../layouts/Layout.astro';
import { stories } from '../data/series.js';

const [featured, ...secondaryStories] = stories;
---
<Layout title="Masseries Orientales | Noticias y resúmenes" description="Noticias, resúmenes y recomendaciones de series coreanas, japonesas y chinas.">
  <section class="hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">EL PARTE SEMANAL <span>·</span> 14 JUN 2024</p>
      <h1>Historias que<br /><em>se quedan.</em></h1>
      <p class="hero-intro">Noticias, resúmenes y ese pequeño detalle que hace que una serie no termine cuando aparecen los créditos.</p>
      <a class="text-link" href="#ultimas">Explorar novedades <span>↓</span></a>
    </div>
    <div class="hero-aside">
      <span class="vertical-label">Nº 07 / JUNIO</span>
      <div class="sun-mark" aria-hidden="true"></div>
      <p>Una mirada cercana a las series orientales que están definiendo la conversación.</p>
    </div>
  </section>

  <section class="lead-story" id="ultimas">
    <div class="lead-image"><img src={featured.image} alt="Paisaje urbano relacionado con {featured.title}" loading="eager" /></div>
    <div class="lead-details">
      <div class="story-meta"><span>{featured.category}</span><span>{featured.date}</span></div>
      <h2>{featured.title}</h2>
      <p>{featured.excerpt}</p>
      <a class="circle-arrow" href="#historias" aria-label="Leer la historia destacada">↗</a>
    </div>
  </section>

  <section class="latest-section" id="historias">
    <div class="section-heading"><h2>Lo último</h2><span>03 / 08</span></div>
    <div class="story-grid">
      {secondaryStories.map((story, index) => (
        <article class:list-large={index === 0} class="story-card">
          <img src={story.image} alt="Imagen de {story.title}" loading="lazy" />
          <div class="story-card-body"><div class="story-meta"><span>{story.category}</span><span>{story.date}</span></div><h3>{story.title}</h3><p>{story.excerpt}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="subscribe" id="suscribete">
    <div><p class="eyebrow">UN CORREO, CADA VIERNES</p><h2>Tu próxima obsesión<br /><em>empieza aquí.</em></h2></div>
    <form><label for="email">Tu email</label><div class="form-row"><input id="email" type="email" placeholder="hola@ejemplo.com" required /><button type="submit" aria-label="Suscribirme">→</button></div><small>Sin ruido. Solo historias que valen la pena.</small></form>
  </section>
</Layout>

<style>
  .hero-shell, .lead-story, .latest-section, .subscribe { max-width: 1180px; margin-inline: auto; padding-inline: 5vw; }
  .hero-shell { min-height: 440px; padding-top: 86px; display: grid; grid-template-columns: 1fr 230px; gap: 70px; align-items: center; }
  .eyebrow, .story-meta { font: 500 10px 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { color: var(--coral); margin: 0 0 25px; }.eyebrow span { color: var(--ink); margin: 0 4px; }
  h1, h2, h3, p { margin-top: 0; }.hero-copy h1 { margin: 0; font-size: clamp(56px, 8vw, 104px); line-height: .91; letter-spacing: -.075em; font-weight: 800; }.hero-copy h1 em, .subscribe h2 em { color: var(--coral); font-family: 'Playfair Display', serif; font-weight: 700; letter-spacing: -.04em; }
  .hero-intro { max-width: 370px; margin: 30px 0 26px; color: var(--muted); font-size: 14px; line-height: 1.6; }.text-link { font-size: 12px; font-weight: 800; border-bottom: 1px solid var(--ink); padding-bottom: 8px; }.text-link span { margin-left: 20px; color: var(--coral); }
  .hero-aside { align-self: stretch; padding-top: 25px; border-left: 1px solid var(--line); padding-left: 24px; display: flex; flex-direction: column; justify-content: space-between; }.vertical-label { writing-mode: vertical-rl; font: 10px 'DM Mono', monospace; color: var(--muted); }.sun-mark { width: 62px; height: 62px; background: var(--sun); border-radius: 50%; }.hero-aside p { font-size: 11px; line-height: 1.5; color: var(--muted); margin: 0; }
  .lead-story { display: grid; grid-template-columns: 1.45fr 1fr; min-height: 410px; margin-top: 30px; }.lead-image { min-height: 410px; overflow: hidden; }.lead-image img, .story-card img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.85); }.lead-details { background: var(--coral); padding: 48px; display: flex; flex-direction: column; align-items: flex-start; }.story-meta { display: flex; gap: 22px; color: var(--muted); }.lead-details .story-meta { color: var(--ink); }.lead-details h2 { max-width: 430px; font-size: clamp(32px, 4vw, 52px); line-height: .98; letter-spacing: -.06em; margin: 64px 0 17px; }.lead-details p { max-width: 340px; font-size: 13px; line-height: 1.6; }.circle-arrow { width: 44px; height: 44px; border: 1px solid var(--ink); border-radius: 50%; display: grid; place-items: center; font-size: 20px; margin-top: auto; transition: background .2s, color .2s; }.circle-arrow:hover { background: var(--ink); color: var(--coral); }
  .latest-section { padding-top: 100px; }.section-heading { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--ink); padding-bottom: 13px; }.section-heading h2 { font-size: 28px; letter-spacing: -.06em; margin: 0; }.section-heading span { font: 10px 'DM Mono', monospace; }.story-grid { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 24px; padding-top: 24px; }.story-card { min-width: 0; }.story-card img { aspect-ratio: 1.35; }.story-card-body { padding-top: 17px; }.story-card h3 { font-size: 21px; line-height: 1.05; letter-spacing: -.045em; margin: 14px 0 10px; }.story-card p { color: var(--muted); font-size: 12px; line-height: 1.5; max-width: 280px; }.story-card .story-meta { font-size: 9px; }.story-card.list-large img { aspect-ratio: 1.65; }.subscribe { margin-top: 120px; padding-top: 52px; padding-bottom: 52px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }.subscribe h2 { font-size: clamp(32px, 4vw, 50px); line-height: .95; letter-spacing: -.06em; margin: 0; }.subscribe form { align-self: end; }.subscribe label { display: block; font: 10px 'DM Mono', monospace; text-transform: uppercase; margin-bottom: 10px; }.form-row { display: flex; border-bottom: 1px solid var(--ink); }.form-row input { background: transparent; border: 0; outline: 0; padding: 12px 0; flex: 1; font: 14px 'Manrope', sans-serif; color: var(--ink); }.form-row button { border: 0; background: none; font-size: 24px; cursor: pointer; }.subscribe small { display: block; color: var(--muted); font-size: 10px; margin-top: 12px; }
  @media (max-width: 760px) { .hero-shell { min-height: auto; padding-top: 62px; grid-template-columns: 1fr; gap: 40px; }.hero-aside { min-height: 150px; }.lead-story { grid-template-columns: 1fr; }.lead-image { min-height: 280px; }.lead-details { min-height: 360px; padding: 30px; }.lead-details h2 { margin-top: 45px; }.story-grid { grid-template-columns: 1fr 1fr; gap: 26px 14px; }.story-card.list-large { grid-column: 1 / -1; }.subscribe { margin-top: 80px; grid-template-columns: 1fr; gap: 45px; } }
  @media (max-width: 450px) { .story-grid { grid-template-columns: 1fr; }.story-card.list-large { grid-column: auto; }.story-card img, .story-card.list-large img { aspect-ratio: 1.4; } }
</style>